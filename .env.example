# Purpose: list safe local environment settings without including real secrets.

# Runtime mode, API container port, host loopback port for Funnel, and host LAN IPv4 address.
NODE_ENV=development
PORT=3000
HOST_API_PORT=3000
HOST_LAN_IP=<your-host-wi-fi-ipv4>

# Public Funnel origin and the authenticated MongoDB connection string used by app containers.
PUBLIC_BASE_URL=https://<your-funnel-host>
MONGO_ROOT_USERNAME=meow
MONGO_ROOT_PASSWORD=<generate-a-random-password>
MONGODB_URI=mongodb://meow:<same-password>@mongodb:27017/meow?authSource=admin

# Internal identity domain and the server-to-server API bearer token.
PHONE_COUNTRY_CODE=+91
EMAIL_DOMAIN=niti
CALLS_API_TOKEN=<generate-a-random-secret>
SESSION_TTL_DAYS=7
OTP_HASH_SECRET=<generate-a-random-secret>

# Telnyx credentials and IDs. Messaging profile IDs are UUIDs, not their display names.
TELNYX_API_KEY=<your-telnyx-api-key>
TELNYX_VOICE_APP_ID=<your-voice-application-id>
TELNYX_CALLER_ID=<your-telnyx-number>
TELNYX_SMS_FROM_NUMBER=<sms-capable-number-assigned-to-profile>
TELNYX_MESSAGING_PROFILE_NAME=MEOW
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_PUBLIC_KEY=

# Telnyx text-to-speech locales and voices used for IVR prompts.
TELNYX_ENGLISH_LANGUAGE=en-IN
TELNYX_HINDI_LANGUAGE=hi-IN
TELNYX_ENGLISH_VOICE=Azure.en-IN-NeerjaNeural
TELNYX_HINDI_VOICE=Azure.hi-IN-SwaraNeural
TELNYX_LANGUAGE_MENU_LANGUAGE=en-US
TELNYX_LANGUAGE_MENU_VOICE=Azure.en-US-AvaMultilingualNeural

# Secret OTP hashing key, expiry window, and maximum incorrect attempts.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Private Compose SMTP sink. No SMTP or Mailpit UI port is published to the host.
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_FROM_ADDRESS=no-reply@niti

# Optional OpenRouter AI tools. The free router selects an available free text model.
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=openrouter/free
